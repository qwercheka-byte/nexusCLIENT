// Resources of "Nexus Launcher.exe". VERSION_* / VERSION_STR are passed by the build (-D...), defaults for manual builds.
#include <winver.h>
#ifndef VERSION_MAJOR
#define VERSION_MAJOR 1
#define VERSION_MINOR 0
#define VERSION_PATCH 0
#define VERSION_STR "1.0.0"
#endif

1 ICON "../nexus.ico"
1 24 "NexusLauncher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION  VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "NEXUS"
      VALUE "FileDescription",  "NEXUS Launcher"
      VALUE "FileVersion",      VERSION_STR
      VALUE "InternalName",     "NexusLauncher"
      VALUE "LegalCopyright",   "MIT License"
      VALUE "OriginalFilename", "Nexus Launcher.exe"
      VALUE "ProductName",      "NEXUS Launcher"
      VALUE "ProductVersion",   VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
